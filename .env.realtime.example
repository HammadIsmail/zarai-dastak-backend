# Realtime deployment environment (Railway/Render)
# Copy to .env and fill with your own secure values.

# Socket.IO
SOCKETIO_PATH=socket.io
SOCKETIO_CORS_ORIGINS=https://haulistry-app.vercel.app
SOCKETIO_PING_INTERVAL=25
SOCKETIO_PING_TIMEOUT=60

# Redis (Upstash TCP / TLS URL)
REDIS_ENABLED=true
REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<UPSTASH_HOST>:6379

# Metered TURN
METERED_TURN_DOMAIN=haulistry.metered.live
METERED_API_KEY=<METERED_API_KEY>
TURN_REGION=global

# Optional static TURN/STUN fallback as JSON array
# TURN_FALLBACK_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
