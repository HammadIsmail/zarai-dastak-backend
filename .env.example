# ============================================================
# Haulistry Backend - Environment Configuration
# Copy this file to '.env' inside the 'backend' folder:
#   copy .env.example .env
# ============================================================

# ── 1. Server Configuration ─────────────────────────────────
APP_NAME="Haulistry Backend"
VERSION="1.0.0"
DEBUG=true
HOST="0.0.0.0"
PORT=4000
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-secure-random-secret-key"
OTP_EXPOSE_IN_RESPONSE=true

# ── 2. Neo4j Graph Database ──────────────────────────────────
# Local Neo4j: bolt://localhost:7687
# Neo4j Aura (Cloud): neo4j+s://<your-aura-instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ── 3. Firebase Admin SDK ────────────────────────────────────
# Option A (Local Dev): Path to service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Option B (Serverless / Cloud): Base64-encoded service account JSON
# FIREBASE_CREDENTIALS_JSON=

FIREBASE_PROJECT_ID=haulistry-1b835
FIREBASE_STORAGE_BUCKET=haulistry-1b835.appspot.com

# ── 4. CORS & Realtime (Socket.IO) ───────────────────────────
ALLOWED_ORIGINS=*
SOCKETIO_PATH=socket.io
SOCKETIO_CORS_ORIGINS=*
SOCKETIO_PING_INTERVAL=25
SOCKETIO_PING_TIMEOUT=60

# ── 5. Redis (State & Socket.IO Pub/Sub) ──────────────────────
# Set REDIS_ENABLED=false if you do not have Redis running locally
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# Upstash REST credentials (optional fallback)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 6. Metered TURN / WebRTC Calling ─────────────────────────
METERED_TURN_DOMAIN=haulistry.metered.live
METERED_API_KEY=
TURN_REGION=global
# Optional fallback ICE servers (JSON array):
# TURN_FALLBACK_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# ── 7. Pricing Defaults (Optional) ───────────────────────────
BASE_RATE_MULTIPLIER=1.0
DISTANCE_RATE_PER_KM=5.0
MINIMUM_CHARGE=100.0
